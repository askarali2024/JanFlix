# ── JanFlix configuration ────────────────────────────────────────
# Copy this file to `.env` and adjust values, or export them in your shell.

# Port the web UI is served on
PORT=3000

# Comma-separated list of directories to scan for movies.
# Paths can be absolute or relative to the project root.
# MEDIA_DIRS=./movies,/mnt/nas/films,/Volumes/Media/cinema
MEDIA_DIRS=./movies

# Where JanFlix stores its JSON database, cached posters and progress
DATA_DIR=./data

# Optional: TMDB API key (https://www.themoviedb.org/settings/api)
# When set, JanFlix enriches the library with posters, backdrops,
# plots, ratings, runtimes and genres. Without it, JanFlix works
# fully offline using generated fallback poster cards.
# TMDB_API_KEY=
